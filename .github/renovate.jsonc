{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests",
  ],

  // Run about bi-weekly.
  "schedule": ["* 5 3,22 * *"],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 10,

  "labels": ["dependencies"],

  "minimumReleaseAge": "7 days",

  // Periodically refresh lockfiles to catch transitive dependency updates.
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 5 3,22 * *"],
  },

  "packageRules": [
    // Auto-merge GitHub Actions updates.
    {
      "matchCategories": ["ci"],
      "automerge": true,
      "groupName": "CI configuration dependencies",
    },

    // Auto-merge npm package updates (dependencies are already pinned by the lockfile).
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
    },

    // Auto-merge Docker base image updates.
    {
      "matchManagers": ["dockerfile"],
      "automerge": true,
    },

    // Auto-merge all Python dependencies (uv.lock makes every update reproducible)…
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
    },

    // …except for packages whose bounds are intentionally conservative.
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": ["django", "wagtail"],
      "enabled": false,
    },
  ],
}
