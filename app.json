{
  "addons": ["heroku-redis:mini", "heroku-postgresql:essential-0"],
  "env": {
    "ALLOWED_HOSTS": {
      "value": "*"
    },
    "DEBUG": {
      "value": "true"
    },
    "SECRET_KEY": {
      "generator": "secret"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "name": "Wagtail Guide",
  "repository": "https://github.com/wagtail/guide",
  "stack": "container",
  "website": "https://guide.wagtail.org/"
}
