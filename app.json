{
  "addons": ["heroku-redis:mini", "heroku-postgresql:essential-0"],
  "env": {
    "ALLOWED_HOSTS": {
      "value": "*"
    },
    "DEBUG": {
      "value": "true"
    },
    "SECRET_KEY": {
      "generator": "secret"
    }
  },
  "environments": {
    "review": {
      "scripts": {
        "postdeploy": "uv run --no-sync --with \"wagtail-factories>=4.1.0,<5.0.0\" python manage.py buildfixtures"
      }
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "name": "Wagtail Guide",
  "repository": "https://github.com/wagtail/guide",
  "stack": "container",
  "website": "https://guide.wagtail.org/"
}
