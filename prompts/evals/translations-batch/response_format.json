{
  "type": "json_schema",
  "json_schema": {
    "name": "translated_segments",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The segment id, copied verbatim from the input."
              },
              "text": {
                "type": "string",
                "description": "The translated segment text, with inline HTML tags preserved."
              }
            },
            "required": ["id", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["segments"],
      "additionalProperties": false
    }
  }
}
