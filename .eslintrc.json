{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["@wagtail/eslint-config-wagtail"],
  "overrides": [
    {
      "files": ["playwright.config.js", "tests/e2e/**/*.js"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          { "devDependencies": true }
        ]
      }
    }
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [],
  "rules": {
    "import/prefer-default-export": "off",
    "prefer-destructuring": "off"
  }
}
