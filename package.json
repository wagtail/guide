{
  "name": "guide",
  "private": true,
  "author": "",
  "type": "module",
  "scripts": {
    "start": "vp build --watch --mode development --minify false --sourcemap inline",
    "build": "vp build",
    "format": "vp fmt",
    "fix": "vp check --fix",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:js": "vp lint --report-unused-disable-directives",
    "lint:format": "vp fmt --check",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "test": "vp test run"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.5",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@wagtail/stylelint-config-wagtail": "^2.0.1",
    "browserslist": "^4.29.3",
    "happy-dom": "^20.14.5",
    "sass": "^1.49.8",
    "stylelint": "^17.16.0",
    "vite-plus": "^1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "5.0.1"
  },
  "browserslist": [
    "Firefox ESR",
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Edge versions",
    "last 1 Firefox version",
    "last 2 iOS versions",
    "last 3 Safari versions",
    "not safari 13",
    "not ie 11"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  }
}
